<!doctype html><html lang="en"><meta charset="utf-8"><title>LakeGuard report</title><body><h1>LakeGuard quality report</h1><p>Rows: {{ profile.row_count }} | Columns: {{ profile.column_count }}</p><h2>Failed checks: {{ failed_count }}</h2><table border="1"><tr><th>Rule</th><th>Column</th><th>Status</th><th>Checked</th><th>Invalid</th><th>Message</th></tr>{% for r in checks %}<tr><td>{{ r.rule_name }}</td><td>{{ r.column }}</td><td>{{ r.status }}</td><td>{{ r.checked_rows }}</td><td>{{ r.invalid_rows }}</td><td>{{ r.message }}</td></tr>{% endfor %}</table></body></html>
